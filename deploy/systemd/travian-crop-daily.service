[Unit]
Description=Travian Daily Crop Changes Report
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/travian-discord-bot
EnvironmentFile=/etc/travian-bots.env
ExecStart=/opt/travian-discord-bot/.venv/bin/python /opt/travian-discord-bot/crop_daily.py
