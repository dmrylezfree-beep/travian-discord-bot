[Unit]
Description=Travian Scout Telegram crop calculator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=travian-scout
StateDirectoryMode=0700
WorkingDirectory=/opt/travian-discord-bot
EnvironmentFile=/etc/travian-scout-token.env
Environment=SCOUT_DATA_DIR=/var/lib/travian-scout
ExecStart=/opt/travian-discord-bot/.venv/bin/python /opt/travian-discord-bot/scout_bot.py
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
