[Unit]
Description=Travian Incoming Attacks Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/travian-discord-bot
EnvironmentFile=/etc/travian-bots.env
Environment=ATTACKS_RUN_SECONDS=0
Environment=ATTACKS_TG_POLL_TIMEOUT=20
ExecStart=/opt/travian-discord-bot/.venv/bin/python /opt/travian-discord-bot/attacks_poll.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
